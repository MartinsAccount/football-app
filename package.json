{
	"name": "football-app",
	"private": true,
	"description": "Personal football betting analysis: match analysis + bet recommendations, arbitrage finder. See CLAUDE.md and docs/PRD.md.",
	"workspaces": [
		"packages/*",
		"frontend",
		"backend"
	],
	"scripts": {
		"dev": "concurrently -k -n api,web -c blue,green \"npm:dev -w backend\" \"npm:dev -w frontend\"",
		"build": "npm run build -w frontend",
		"test": "npm run test:ci --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"format": "prettier --write \"{frontend,packages}/**/*.{ts,tsx,js,cjs,css}\"",
		"format:check": "prettier --check \"{frontend,packages}/**/*.{ts,tsx,js,cjs,css}\"",
		"verify": "npm run format:check && npm run verify --workspaces --if-present"
	},
	"devDependencies": {
		"concurrently": "9.1.0",
		"prettier": "^2.8.8",
		"typescript": "^5.6.3",
		"vitest": "^2.1.8"
	}
}
