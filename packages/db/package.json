{
	"name": "@football/db",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Database layer: Postgres SQL migrations (Supabase-compatible, standard Postgres), migration runner, (later) repositories and adapters.",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest",
		"test:ci": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "npm run typecheck && npm run test:ci",
		"import:legacy": "vite-node scripts/import-legacy.ts",
		"import:history": "vite-node scripts/import-history.ts",
		"import:odds-csv": "vite-node scripts/import-odds-csv.ts",
		"backtest": "vite-node scripts/backtest.ts",
		"backtest:elo-logit": "vite-node scripts/backtest-elo-logit.ts",
		"backtest:v1": "vite-node scripts/backtest-model-v1.ts",
		"recommendations": "vite-node scripts/recommendations.ts",
		"arbitrage": "vite-node scripts/arbitrage.ts",
		"db:migrate": "vite-node scripts/db-migrate.ts"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1"
	},
	"dependencies": {
		"@electric-sql/pglite": "^0.5.16",
		"@football/core": "0.1.0",
		"pg": "^8.23.1"
	}
}
