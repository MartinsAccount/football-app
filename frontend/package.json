{
	"name": "football-api",
	"version": "0.1.0",
	"private": true,
	"dependencies": {
		"@testing-library/jest-dom": "^5.14.1",
		"@testing-library/react": "^11.2.7",
		"@testing-library/user-event": "^12.8.3",
		"@types/jest": "^26.0.24",
		"@types/node": "^12.20.19",
		"@types/react": "^17.0.17",
		"@types/react-dom": "^17.0.9",
		"mobx": "^5.15.7",
		"mobx-react": "^5.4.4",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"react-router-dom": "^5.3.0",
		"react-scripts": "5.0.1",
		"sass": "^1.38.2",
		"uuid": "^8.3.2",
		"web-vitals": "^1.1.2"
	},
	"scripts": {
		"start": "react-scripts start",
		"build": "react-scripts build",
		"test": "react-scripts test",
		"test:ci": "react-scripts test --watchAll=false",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,js,css}\"",
		"format:check": "prettier --check \"src/**/*.{ts,tsx,js,css}\"",
		"verify": "npm run typecheck && npm run format:check && npm run test:ci",
		"eject": "react-scripts eject"
	},
	"proxy": "http://localhost:5000",
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"devDependencies": {
		"ajv": "^8.12.0",
		"prettier": "^2.8.8",
		"tailwindcss": "^3.3.5",
		"typescript": "^4.9.5"
	}
}
