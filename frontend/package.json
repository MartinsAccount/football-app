{
	"name": "football-app-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"dependencies": {
		"@testing-library/jest-dom": "^5.14.1",
		"@testing-library/react": "^11.2.7",
		"@testing-library/user-event": "^12.8.3",
		"@types/node": "^12.20.19",
		"@types/react": "^17.0.17",
		"@types/react-dom": "^17.0.9",
		"mobx": "^5.15.7",
		"mobx-react": "^5.4.4",
		"react": "^17.0.2",
		"react-dom": "^17.0.2",
		"react-router-dom": "^5.3.0",
		"uuid": "^8.3.2",
		"web-vitals": "^1.1.2",
		"@football/core": "*",
		"@football/contract": "*"
	},
	"scripts": {
		"tokens": "node src/design/tokens/build-tokens.mjs",
		"tokens:check": "node src/design/tokens/build-tokens.mjs --check",
		"predev": "npm run tokens",
		"prestart": "npm run tokens",
		"prebuild": "npm run tokens",
		"start": "vite",
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"test:ci": "vitest run",
		"typecheck": "tsc --noEmit",
		"verify": "npm run tokens:check && npm run typecheck && npm run test:ci && npm run build"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.4",
		"autoprefixer": "^10.4.20",
		"jsdom": "^25.0.1",
		"postcss": "^8.4.49",
		"tailwindcss": "^3.3.5",
