# Copy to .env and fill in. .env is git-ignored.
# RapidAPI host (api-football-v1.p.rapidapi.com) — used by FetchService
VITE_RAPIDAPI_KEY=
# Direct API-Sports host (v3.football.api-sports.io), free plan — used by FetchService3
VITE_APISPORTS_KEY=
# Data source: fixture (default, saved API responses, 0 live calls) | live (real API-Football calls, counts against 100/day)
VITE_DATA_MODE=fixture
