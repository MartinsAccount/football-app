{
  "$description": "Odds elemző – Floodlight (D1) design tokenek. Formátum: W3C Design Tokens (DTCG). Ebből generált: tokens.css, tokens.ts. Ezt a fájlt szerkeszd, a másik kettőt generáld újra.",
  "color": {
    "bg": {
      "canvas":   { "$type": "color", "$value": "#0B1220", "$description": "Oldal háttere" },
      "surface":  { "$type": "color", "$value": "#121B2E", "$description": "Kártyák, panelek" },
      "raised":   { "$type": "color", "$value": "#17223A", "$description": "Panelen belüli csempék, chipek" },
      "inset":    { "$type": "color", "$value": "#0E1728", "$description": "Süllyesztett info-doboz panelen belül" },
      "track":    { "$type": "color", "$value": "#1E2A44", "$description": "Sávok, progressbarok alapja, avatar" },
      "selected": { "$type": "color", "$value": "#13283A", "$description": "Kiválasztott (szelvényen lévő) kártya" },
      "info":     { "$type": "color", "$value": "#10202A", "$description": "Motor-javaslat / info banner" }
    },
    "border": {
      "default": { "$type": "color", "$value": "#23304D" },
      "strong":  { "$type": "color", "$value": "#2E3D5E", "$description": "Másodlagos gombok kerete, szaggatott elválasztó" },
      "info":    { "$type": "color", "$value": "#1F4A4A" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "#E8EDF7" },
      "secondary": { "$type": "color", "$value": "#C7D0E2" },
      "muted":     { "$type": "color", "$value": "#93A0B8", "$description": "Címkék, meta. 6:1 a surface-en" },
      "inverse":   { "$type": "color", "$value": "#0B1220", "$description": "Szöveg accent / világos kitöltésen" }
    },
    "accent": {
      "default": { "$type": "color", "$value": "#35E0C2", "$description": "Az egyetlen kiemelőszín: modell, pozitív érték, kiválasztás, fő CTA" },
      "alt-blue":   { "$type": "color", "$value": "#8FB3FF", "$description": "Alternatív téma-akcent" },
      "alt-amber":  { "$type": "color", "$value": "#FFC56B", "$description": "Alternatív téma-akcent (ütközik a warninggal, csak ha a warning átszíneződik)" },
      "alt-violet": { "$type": "color", "$value": "#C4A1FF", "$description": "Alternatív téma-akcent" }
    },
    "signal": {
      "positive": { "$type": "color", "$value": "{color.accent.default}" },
      "negative": { "$type": "color", "$value": "#FF8A65", "$description": "Negatív tényező, vereség, magas kockázat, min. alatti odds" },
      "warning":  { "$type": "color", "$value": "#FFC56B", "$description": "Adatminőségi figyelmeztetés, közepes kockázat" },
      "neutral":  { "$type": "color", "$value": "#8D99B3", "$description": "Döntetlen" }
    },
    "data": {
      "model":  { "$type": "color", "$value": "{color.accent.default}", "$description": "„Szerintünk” sáv" },
      "market": { "$type": "color", "$value": "#6E7C99", "$description": "„Irodák szerint” sáv. CSAK grafikára, szövegre nem (4,1:1)" },
      "track":  { "$type": "color", "$value": "{color.bg.track}" }
    },
    "result": {
      "win":  { "$type": "color", "$value": "{color.accent.default}", "$description": "Gy chip" },
      "draw": { "$type": "color", "$value": "{color.signal.neutral}", "$description": "D chip" },
      "loss": { "$type": "color", "$value": "{color.signal.negative}", "$description": "V chip" },
      "on":   { "$type": "color", "$value": "{color.text.inverse}", "$description": "Betű a chipen" }
    },
    "zone": {
      "champions": { "$type": "color", "$value": "#2C4A7A" },
      "europe":    { "$type": "color", "$value": "#4A4470" },
      "mid":       { "$type": "color", "$value": "#1E2A44" },
      "relegation":{ "$type": "color", "$value": "#6A3442" },
      "home":      { "$type": "color", "$value": "{color.text.primary}", "$description": "Hazai csapat jelölése a tabella-sávon" },
      "away":      { "$type": "color", "$value": "{color.accent.default}", "$description": "Vendég csapat jelölése" }
    },
    "risk": {
      "low":    { "$type": "color", "$value": "{color.accent.default}", "$description": "Találati esély ≥ 35%" },
      "medium": { "$type": "color", "$value": "{color.signal.warning}", "$description": "15–35%" },
      "high":   { "$type": "color", "$value": "{color.signal.negative}", "$description": "< 15%" }
    },
    "warning-surface": {
      "bg":     { "$type": "color", "$value": "#2A1F14" },
      "border": { "$type": "color", "$value": "#5A4220" }
    },
    "overlay": { "$type": "color", "$value": "rgba(3, 8, 14, 0.6)", "$description": "Mobil alsó lap mögötti sötétítés" }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Sora", "system-ui", "sans-serif"], "$description": "Címek és nagy számok" },
      "body":    { "$type": "fontFamily", "$value": ["Manrope", "system-ui", "sans-serif"], "$description": "Minden más" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "heavy":    { "$type": "fontWeight", "$value": 800 }
    },
    "size": {
      "micro":     { "$type": "dimension", "$value": "11px", "$description": "Tile-címkék (odds, min.)" },
      "caption":   { "$type": "dimension", "$value": "12px" },
      "small":     { "$type": "dimension", "$value": "13px" },
      "body":      { "$type": "dimension", "$value": "15px" },
      "lead":      { "$type": "dimension", "$value": "17px", "$description": "Párosítás neve kártyán" },
      "h3":        { "$type": "dimension", "$value": "20px" },
      "h2":        { "$type": "dimension", "$value": "22px" },
      "h1-mobile": { "$type": "dimension", "$value": "28px" },
      "h1":        { "$type": "dimension", "$value": "42px" },
      "display":   { "$type": "dimension", "$value": "48px" },
      "num-s":     { "$type": "dimension", "$value": "20px" },
      "num-m":     { "$type": "dimension", "$value": "24px" },
      "num-l":     { "$type": "dimension", "$value": "28px" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.1 },
      "snug":  { "$type": "number", "$value": 1.3 },
      "body":  { "$type": "number", "$value": 1.5 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.03em" },
      "title":   { "$type": "dimension", "$value": "-0.02em" },
      "label":   { "$type": "dimension", "$value": "0.08em", "$description": "Nagybetűs szekciócímkék" }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "2px" },
    "2":  { "$type": "dimension", "$value": "4px" },
    "3":  { "$type": "dimension", "$value": "6px" },
    "4":  { "$type": "dimension", "$value": "8px" },
    "5":  { "$type": "dimension", "$value": "10px" },
    "6":  { "$type": "dimension", "$value": "12px" },
    "7":  { "$type": "dimension", "$value": "14px" },
    "8":  { "$type": "dimension", "$value": "16px" },
    "9":  { "$type": "dimension", "$value": "18px" },
    "10": { "$type": "dimension", "$value": "20px" },
    "11": { "$type": "dimension", "$value": "22px" },
    "12": { "$type": "dimension", "$value": "24px" },
    "14": { "$type": "dimension", "$value": "28px" },
    "16": { "$type": "dimension", "$value": "32px" },
    "18": { "$type": "dimension", "$value": "36px" },
    "28": { "$type": "dimension", "$value": "56px" }
  },
  "radius": {
    "xs":   { "$type": "dimension", "$value": "2px",  "$description": "Tabella-sáv cellák" },
    "s":    { "$type": "dimension", "$value": "6px",  "$description": "Gy/D/V chip" },
    "m":    { "$type": "dimension", "$value": "10px", "$description": "Lenyitó gomb, kis gombok" },
    "l":    { "$type": "dimension", "$value": "12px", "$description": "Gombok, tét-választó" },
    "xl":   { "$type": "dimension", "$value": "16px", "$description": "Csempék, banner" },
    "2xl":  { "$type": "dimension", "$value": "18px", "$description": "Tippkártya" },
    "3xl":  { "$type": "dimension", "$value": "24px", "$description": "Szelvény-panel, nagy panelek" },
    "sheet":{ "$type": "dimension", "$value": "28px", "$description": "Mobil alsó lap felső sarkai" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "touch":       { "$type": "dimension", "$value": "44px", "$description": "Minimum kattintható méret" },
    "control-lg":  { "$type": "dimension", "$value": "48px" },
    "cta":         { "$type": "dimension", "$value": "52px" },
    "chip":        { "$type": "dimension", "$value": "22px", "$description": "Gy/D/V négyzet" },
    "bar":         { "$type": "dimension", "$value": "6px",  "$description": "Valószínűség-sáv vastagsága kártyán" },
    "bar-lg":      { "$type": "dimension", "$value": "10px" },
    "strip":       { "$type": "dimension", "$value": "14px", "$description": "Tabella-sáv magassága" },
    "container":   { "$type": "dimension", "$value": "1280px" },
    "gutter":      { "$type": "dimension", "$value": "28px" },
    "gutter-mobile": { "$type": "dimension", "$value": "18px" },
    "card-min":    { "$type": "dimension", "$value": "320px", "$description": "Tippkártya-rács minmax alsó határa" },
    "main-basis":  { "$type": "dimension", "$value": "600px" },
    "aside-basis": { "$type": "dimension", "$value": "360px" }
  },
  "motion": {
    "fast":   { "$type": "duration", "$value": "120ms" },
    "base":   { "$type": "duration", "$value": "180ms" },
    "slow":   { "$type": "duration", "$value": "260ms", "$description": "Lenyitás, alsó lap" },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "focus": {
    "ring": { "$type": "dimension", "$value": "2px", "$description": "outline: 2px solid accent; offset 2px" }
  }
}
